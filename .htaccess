# ============================================================
# DEK Advisory Group — server config
# Apache. If the host runs nginx or IIS, hand these rules to
# them; the redirects in particular must not be skipped.
# ============================================================

Options -Indexes
DirectoryIndex index.html index.shtml

# ---- Preserve the old .shtml URLs -------------------------
# The previous site used .shtml. These 301s keep existing
# links, bookmarks and search rankings pointing at the right
# pages instead of dropping them on a 404.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule ^index\.shtml$        /                 [R=301,L]
  RewriteRule ^services\.shtml$     /services.html    [R=301,L]
  RewriteRule ^contact\.shtml$      /contact.html     [R=301,L]
  RewriteRule ^dion-kratz\.shtml$   /about.html#dion  [R=301,L,NE]
  RewriteRule ^erica-kratz\.shtml$  /about.html#erica [R=301,L,NE]
  # The old site had a typo'd link to this path
  RewriteRule ^serica-kratz\.shtml$ /about.html#erica [R=301,L,NE]

  # The FSG moved from /pdf/ into /assets/pdf/
  RewriteRule ^pdf/DEK-Financial-Services-Guide\.pdf$ /assets/pdf/DEK-Financial-Services-Guide.pdf [R=301,L]

  # Force https and drop www
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

ErrorDocument 404 /404.html

# ---- Compression ------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# ---- Caching ----------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType application/pdf         "access plus 1 week"
  ExpiresByType text/html               "access plus 1 hour"
</IfModule>

# ---- Security headers -------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
